# JWT signing secret — set to a long random string in production
SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
JWT_SECRET_FILE=.jwt_secret
SETUP_TOKEN=generate-a-separate-one-time-setup-secret

# MariaDB/MySQL connection string
DATABASE_URL=mysql+pymysql://user:password@host:3306/pos_system

# Privileged MariaDB connection used only to create each restaurant's physical
# database and grant the normal DATABASE_URL user access to it.
TENANT_DATABASE_ADMIN_URL=mysql+pymysql://root:root-password@host:3306/pos_system
TENANT_DATABASE_APP_USER=user
TENANT_DATABASE_APP_HOST=%

# Per-restaurant Google Drive: each restaurant Admin connects their own Google
# account in Web Admin → Settings. Needs a "Web application" OAuth client with
# redirect URI {PUBLIC_BASE_URL}/web/settings/google-drive/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Operator-only: full database dump (all restaurants) to the operator's Drive
GDRIVE_FOLDER_ID=
# In Docker, mount token.json at this path (read/write so refreshed OAuth
# credentials can be saved), e.g. /run/secrets/gdrive_token.json.
GDRIVE_TOKEN_FILE=

# Optional local-development settings (keep unset in production)
CORS_ORIGINS=http://127.0.0.1:7357
WEB_COOKIE_SECURE=false
ENABLE_SCHEDULER=false

# Public HTTPS origin used in email verification links (no trailing slash)
PUBLIC_BASE_URL=https://pos.example.com

# SMTP account used to verify newly registered restaurant Admins
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="K POS <no-reply@example.com>"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Contact shown on the public /privacy and /terms pages
SUPPORT_EMAIL=
